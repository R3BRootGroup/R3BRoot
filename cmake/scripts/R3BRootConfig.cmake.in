@PACKAGE_INIT@

# Check for needed environment variables
if(NOT DEFINED ENV{SIMPATH})
    message(
        FATAL_ERROR
        "You did not define the environment variable SIMPATH which is needed to find the external packages. Please set this variable and execute cmake again."
    )
endif(NOT DEFINED ENV{SIMPATH})

if(NOT DEFINED ENV{FAIRROOTPATH})
    message(
        FATAL_ERROR
        "You did not define the environment variable FAIRROOTPATH which is needed to find FairRoot. Please set this variable and execute cmake again."
    )
endif()

list(APPEND CMAKE_PREFIX_PATH $ENV{SIMPATH} $ENV{FAIRROOTPATH})

include(CMakeFindDependencyMacro)
find_dependency(FairRoot CONFIG)
find_dependency(ROOT CONFIG)
find_dependency(FairLogger CONFIG)
find_dependency(FairMQ CONFIG)
find_dependency(Boost CONFIG)
find_dependency(fmt CONFIG)
find_dependency(Geant4 CONFIG)
find_dependency(Geant4VMC CONFIG)
find_dependency(nlohmann_json CONFIG)
find_dependency(Flatbuffers CONFIG)
find_dependency(Geant3 CONFIG)
find_dependency(Protobuf MODULE)
find_dependency(VMC CONFIG)

# find_dependency(VGM CONFIG)
# find_dependency(Pythia6)
# find_dependency(msgpack CONFIG)
# find_dependency(IWYU CONFIG)
# find_dependency(GSL CONFIG)

# imported targets

include(${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@ConfigVersion.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Config-targets.cmake)
