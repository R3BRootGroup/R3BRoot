#
#  Created by J.L. Rodriguez-Sanchez on 01/09/2025
#  Geant4 configuration macro
#  (called from Root macro R3BRoot/gconfig/g4Config.C)

# Exclude Geant4 event cout
#/mcVerbose/eventAction 0

# Exclude all the couts
#/mcVerbose/all 0

# More fine-grained mcVerbose control
#/mcVerbose/runAction 0
#/mcVerbose/trackingAction 0
#/mcVerbose/trackManager 0
#/mcVerbose/geometryManager 0
#/mcVerbose/regionsManager 0
#/mcVerbose/physicsList 0

# Silence standard Geant4 verbose outputs
#/event/verbose 0
#/had/verbose 0
#/em/verbose 0
#/run/verbose 0
/tracking/verbose 0
#/stepping/verbose 0
#/control/verbose 0

# Set the limit density for low density materials
# to include air (use for correct stepping).
/mcDet/setLimitDensity 2.e-3 g/cm3

# Store secondaries
#/mcTracking/saveSecondaries DoNotSave
#/mcTracking/saveSecondaries SaveInStep
#/mcTracking/saveSecondariesInStep true

#/process/eLoss/subsec  false
#/process/eLoss/minsubsec 2 cm
#/process/had/verbose 0
#/process/em/verbose 0

#/mcPhysics/g4ParticleHPVerbose 0
#/mcPhysics/setSpecialCuts true
#/mcPhysics/rangeCuts 0.1 mm
#/mcPhysics/rangeCutForElectron 0.1 mm
#/mcPhysics/printGeneralCuts true
#/mcPhysics/rangeCutForGamma  1. mm
#/mcPhysics/printGlobalCuts

#/cuts/setLowEdge 100 eV
#/cuts/setHighEdge 100 GeV

#/control/manual   
#/control/createHTML  

